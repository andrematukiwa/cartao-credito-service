        <mxCell id="c_p2" value="201 Created + Location&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;CPF mascarado na resposta&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
