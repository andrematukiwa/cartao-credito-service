        <mxCell id="c_d2" value="CPF ou e-mail&lt;br&gt;já cadastrado?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
